+    /// Load and apply weights to float (bf16/fp32, 양자화 없음) text decoder. Per-shard streaming.
+    /// GoldenLink 패치: 파인튜닝한 Qwen3-ASR을 원본 정밀도 그대로 쓰기 위해 추가.
+    public static func loadTextDecoderWeights(
+        into textModel: FloatTextModel,
+        from directory: URL
+    ) throws {
+        let files = try safetensorFiles(in: directory)
+        for file in files {
+            let raw = try loadSafetensors(url: file)
+            let textWeights = stripPrefix(raw, prefix: "model.")
+            if textWeights.isEmpty { continue }
+            applyFloatTextDecoderComponents(to: textModel, weights: textWeights)
+        }
+    }
+
