# cp turn/.env.example turn/.env 후 이 장비의 실제 네트워크에 맞게 수정.
# 공인 IP 또는 DNS only(Cloudflare 프록시 끔) 도메인. HTTP 터널 주소 사용 불가.
TURN_HOST=turn.example.com
# 서버에 공인 IP가 직접 붙으면 그 IP, NAT 뒤면 공인IP/이장비의LAN_IP
TURN_EXTERNAL_IP=203.0.113.10/192.168.0.10
# openssl rand -hex 32 로 생성. hub와 coturn이 이 값을 공유한다.
HUB_TURN_SECRET=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49259
HUB_TURN_TTL_SEC=3600
# 선택: 신뢰할 수 있는 인증서가 있으면 TLS도 광고한다(기본 5349).
# TURN_CERT=/absolute/path/fullchain.pem
# TURN_PKEY=/absolute/path/privkey.pem
# TURN_TLS_PORT=5349
# 별도 서버에서 TURN을 상시 실행한다면 external. 기본 local은 start-all과 함께 실행/종료.
TURN_MODE=local
